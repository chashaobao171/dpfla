# Model weights - large files, download from ultralytics or re-upload manually
*.pt

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Logs and runs
logs_*/
runs/
dist_run/
cache/

# tb/ 是 TensorBoard 事件目录，**故意纳入 git 跟踪**（曲线跨主机留存），勿在此忽略

# Temp files
*.yaml
!visdrone.yaml
visdrone_temp*.yaml
*.log

# 例外①：归档的合格日志要进仓库（供跨主机同步与对外引用）
!log/
!log/**/*.log

# 例外②：原始日志也一并推送（2026-10-16 用户要求：logs_3/ 全部原始日志跨主机留存，体积 ~9MB 可接受）
!logs_3/
!logs_3/**/*.log

# Data (large, download separately)
data/

# Editor config (machine-specific)
.idea/
.kiro/
.vscode/
*.swp
*.swo
.ipynb_checkpoints/
